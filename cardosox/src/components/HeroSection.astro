---
---

<section class="pt-32 pb-20 px-6">
  <div class="max-w-5xl mx-auto text-center">
    <!-- Badge -->
    <div class="inline-block mb-6 px-4 py-2 rounded-full glass">
      <p class="text-sm font-semibold text-secondary">✨ Premium Web Scraping Solution</p>
    </div>

    <!-- Main Headline -->
    <h1 class="text-5xl md:text-7xl font-bold mb-6 gradient-text leading-tight">
      Scrape the Web at Scale
    </h1>

    <!-- Subheading -->
    <p class="text-xl text-on-surface-variant mb-12 max-w-2xl mx-auto leading-relaxed">
      CardosoX extracts company data, emails, phone numbers, and addresses from multiple websites simultaneously. Built for speed, reliability, and ease of use.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
      <a href="/scraper" class="btn-primary text-lg px-8 py-4">
        Start Scraping Now
      </a>
      <button class="btn-secondary text-lg px-8 py-4">
        View Documentation
      </button>
    </div>

    <!-- Hero Image / Features Grid -->
    <div class="grid md:grid-cols-3 gap-6 mt-16">
      <div class="glass glass-padding rounded-xl p-6 hover-lift">
        <div class="text-4xl mb-3">⚡</div>
        <h3 class="text-lg font-semibold text-on-surface mb-2">Lightning Fast</h3>
        <p class="text-on-surface-variant">Scrape 10+ websites simultaneously with our optimized infrastructure.</p>
      </div>

      <div class="glass glass-padding rounded-xl p-6 hover-lift">
        <div class="text-4xl mb-3">🛡️</div>
        <h3 class="text-lg font-semibold text-on-surface mb-2">Anti-Bot Protection</h3>
        <p class="text-on-surface-variant">Bypass Cloudflare, random user agents, and stealth detection.</p>
      </div>

      <div class="glass glass-padding rounded-xl p-6 hover-lift">
        <div class="text-4xl mb-3">📊</div>
        <h3 class="text-lg font-semibold text-on-surface mb-2">Export Anywhere</h3>
        <p class="text-on-surface-variant">Download results as CSV or JSON for easy integration.</p>
      </div>
    </div>
  </div>
</section>
