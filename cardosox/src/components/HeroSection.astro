---
---

<section class="pt-32 pb-20 px-6">
  <div class="max-w-5xl mx-auto text-center">
    <div class="inline-block mb-6 px-4 py-2 rounded-full glass">
      <p class="text-sm font-semibold text-secondary">Entity-aware web intelligence</p>
    </div>

    <h1 class="text-5xl md:text-7xl font-bold mb-6 gradient-text leading-tight">
      Scrape the Web at Scale
    </h1>

    <p class="text-xl text-on-surface-variant mb-12 max-w-2xl mx-auto leading-relaxed">
      CardosoX extracts company listings, contacts, websites, socials, and pricing quotes from rendered pages without mixing data between businesses.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
      <a href="/scraper" class="btn-primary text-lg px-8 py-4">
        Start Scraping Now
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mt-16">
      <div class="glass glass-padding rounded-xl p-6 hover-lift">
        <div class="text-sm uppercase tracking-[0.24em] text-on-surface-variant mb-3">01</div>
        <h3 class="text-lg font-semibold text-on-surface mb-2">Multi-Listing Pages</h3>
        <p class="text-on-surface-variant">A single URL can produce separate rows for every detected company or business listing.</p>
      </div>

      <div class="glass glass-padding rounded-xl p-6 hover-lift">
        <div class="text-sm uppercase tracking-[0.24em] text-on-surface-variant mb-3">02</div>
        <h3 class="text-lg font-semibold text-on-surface mb-2">Entity Grouping</h3>
        <p class="text-on-surface-variant">Contacts are matched by DOM block and proximity so emails and phones stay with the right business.</p>
      </div>

      <div class="glass glass-padding rounded-xl p-6 hover-lift">
        <div class="text-sm uppercase tracking-[0.24em] text-on-surface-variant mb-3">03</div>
        <h3 class="text-lg font-semibold text-on-surface mb-2">Quotes Included</h3>
        <p class="text-on-surface-variant">Pricing tables, packages, fees, and starting prices are available in JSON and CSV exports.</p>
      </div>
    </div>
  </div>
</section>
