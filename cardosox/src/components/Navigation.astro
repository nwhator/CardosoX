---
---

<nav class="fixed top-0 left-0 right-0 z-50 glass-nav">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <div class="w-10 h-10 rounded-xl bg-white text-black flex items-center justify-center shadow-[0_0_28px_rgba(255,255,255,0.18)]">
        <span class="font-bold text-lg">CX</span>
      </div>
      <h1 class="text-xl font-bold gradient-text hidden sm:block">CardosoX</h1>
    </div>

    <div class="flex items-center gap-3 sm:gap-5 text-sm">
      <a href="/" class="text-on-surface hover:text-white/70 transition-colors">
        Home
      </a>
      <a href="/scraper" class="text-on-surface hover:text-white/70 transition-colors">
        Scraper
      </a>
      <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Toggle theme" aria-pressed="false">
        <span class="theme-toggle__thumb" aria-hidden="true"></span>
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a7.5 7.5 0 1 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="4.25" stroke="currentColor" stroke-width="1.8"/>
          <path d="M12 2.5v2.25M12 19.25v2.25M4.75 4.75l1.6 1.6M17.65 17.65l1.6 1.6M2.5 12h2.25M19.25 12h2.25M4.75 19.25l1.6-1.6M17.65 6.35l1.6-1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<script is:inline>
  const toggle = document.getElementById('theme-toggle');
  const htmlElement = document.documentElement;

  const syncTheme = () => {
    const isLight = htmlElement.classList.contains('light');
    if (toggle) {
      toggle.setAttribute('aria-pressed', String(isLight));
    }
    window.localStorage.setItem('cardosox-theme', isLight ? 'light' : 'dark');
  };

  syncTheme();

  toggle?.addEventListener('click', () => {
    const nextTheme = htmlElement.classList.contains('light') ? 'dark' : 'light';
    htmlElement.classList.toggle('light', nextTheme === 'light');
    htmlElement.classList.toggle('dark', nextTheme !== 'light');
    htmlElement.dataset.theme = nextTheme;
    syncTheme();
  });
</script>
